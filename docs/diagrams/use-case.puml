@startuml
left to right direction

actor "Admin" as Admin
actor "Penyewa" as Tenant

rectangle "Garage Rental Management System" {

    usecase "Login" as UC_Login
    usecase "Logout" as UC_Logout
    usecase "Registrasi Penyewa" as UC_Register

    usecase "Melihat Dashboard" as UC_Dashboard
    usecase "Melihat Profil Penyewa" as UC_Profile
    usecase "Membuat Sewa Garasi Baru" as UC_Rent
    usecase "Memilih Kendaraan" as UC_Vehicle
    usecase "Melihat Garasi Tersedia" as UC_Available
    usecase "Validasi Kompatibilitas" as UC_Compatibility
    usecase "Menghitung Biaya Sewa" as UC_Cost
    usecase "Upload Bukti Pelunasan" as UC_Payment
    usecase "Melihat Riwayat Sewa" as UC_History

    usecase "Membuat Garasi Massal" as UC_CreateGarage
    usecase "Generate ID Garasi" as UC_GenerateID
    usecase "Melihat Daftar Garasi" as UC_ListGarage
    usecase "Verifikasi Pendaftar" as UC_Verify
    usecase "Menerima / Menolak Penyewa" as UC_Approve
    usecase "Melihat Sewa Aktif" as UC_ActiveRentals
    usecase "Memperpanjang Sewa" as UC_Extend
    usecase "Menghitung Biaya Perpanjangan" as UC_ExtendCost
    usecase "Upload Bukti Perpanjangan" as UC_ExtendPayment
    usecase "Melihat Laporan Sewa" as UC_Report
}

Tenant --> UC_Register
Tenant --> UC_Login
Tenant --> UC_Logout
Tenant --> UC_Dashboard
Tenant --> UC_Profile
Tenant --> UC_Rent
Tenant --> UC_History

UC_Rent ..> UC_Vehicle : <<include>>
UC_Rent ..> UC_Available : <<include>>
UC_Rent ..> UC_Compatibility : <<include>>
UC_Rent ..> UC_Cost : <<include>>
UC_Rent ..> UC_Payment : <<include>>

Admin --> UC_Login
Admin --> UC_Logout
Admin --> UC_Dashboard
Admin --> UC_CreateGarage
Admin --> UC_ListGarage
Admin --> UC_Verify
Admin --> UC_ActiveRentals
Admin --> UC_Extend
Admin --> UC_Report

UC_CreateGarage ..> UC_GenerateID : <<include>>
UC_Verify ..> UC_Approve : <<include>>
UC_Extend ..> UC_ExtendCost : <<include>>
UC_Extend ..> UC_ExtendPayment : <<include>>

@enduml
