@startuml

hide circle
skinparam linetype ortho

entity "users" as users {
    * user_id : TEXT <<PK>>
    --
    email : VARCHAR(255) <<UNIQUE, NOT NULL>>
    password : VARCHAR(255) <<NOT NULL>>
    role : ENUM('ADMIN','TENANT') <<NOT NULL>>
    created_at : TEXT <<NOT NULL>>
}

entity "admin" as admin {
    * admin_id : TEXT <<PK, FK>>
    --
    name : VARCHAR(64) <<NOT NULL>>
}

entity "tenants" as tenants {
    * tenant_id : TEXT <<PK, FK>>
    --
    nik : VARCHAR(16) <<UNIQUE, NOT NULL>>
    full_name : VARCHAR(50) <<NOT NULL>>
    phone_number : VARCHAR(20) <<NOT NULL>>
    is_verified : ENUM('PENDING','APPROVED','REJECTED') <<NOT NULL>>
}

entity "garage_types" as garage_types {
    * type_id : INTEGER <<PK>>
    --
    name : ENUM('BIKE','CAR','EV') <<UNIQUE, NOT NULL>>
    code_prefix : ENUM('S','C','E') <<UNIQUE, NOT NULL>>
    daily_rate : INTEGER <<NOT NULL>>
    er_per_kwh : INTEGER <<NULL>>
}

entity "garage_sequences" as sequences {
    * type_id : INTEGER <<PK, FK>>
    --
    last_num : INTEGER <<NOT NULL, DEFAULT 0>>
}

entity "garages" as garages {
    * garage_id : CHAR(4) <<PK>>
    --
    type_id : INTEGER <<FK, NOT NULL>>
    status : ENUM('AVAILABLE','USED') <<NOT NULL>>
    created_at : TEXT <<NOT NULL>>
}

entity "rentals" as rentals {
    * rental_id : CHAR(36) <<PK>>
    --
    tenant_id : CHAR(36) <<FK, NOT NULL>>
    garage_id : CHAR(4) <<FK, NOT NULL>>
    start_date : DATE <<NOT NULL>>
    end_date : DATE <<NOT NULL>>
    duration_days : INTEGER <<NOT NULL>>
    rental_type : ENUM('DAILY','MONTHLY') <<NOT NULL>>
    vehicle_type : ENUM('BICYCLE','MOTORCYCLE','CAR','ELECTRIC_CAR') <<NOT NULL>>
    plate_number : VARCHAR(20) <<NULL>>
    brand : VARCHAR(30) <<NOT NULL>>
    model : VARCHAR(30) <<NOT NULL>>
    battery_capacity_kwh : DECIMAL(7,2) <<NULL>>
    rental_fee : INTEGER <<NOT NULL>>
    electricity_fee : INTEGER <<NOT NULL>>
    total_price : INTEGER <<NOT NULL>>
    payment_proof : VARCHAR(255) <<NOT NULL>>
    status : ENUM('ACTIVE','COMPLETED') <<NOT NULL>>
    created_at : TEXT <<NOT NULL>>
}

entity "rental_extensions" as extensions {
    * rentalext_id : CHAR(36) <<PK>>
    --
    rental_id : CHAR(36) <<FK, NOT NULL>>
    admin_id : CHAR(36) <<FK, NOT NULL>>
    previous_end_date : DATE <<NOT NULL>>
    new_end_date : DATE <<NOT NULL>>
    additional_duration_days : INTEGER <<NOT NULL>>
    extension_fee : INTEGER <<NOT NULL>>
    payment_proof : VARCHAR(255) <<NOT NULL>>
    created_at : TEXT <<NOT NULL>>
}

users ||--o| admin : has
users ||--o| tenants : has

garage_types ||--|| sequences : tracks
garage_types ||--o{ garages : classifies

tenants ||--o{ rentals : creates
garages ||--o{ rentals : used in

rentals ||--o{ extensions : extended by
admin ||--o{ extensions : processes

@enduml
